# Copiar como .env y definir una contraseña propia de 16 caracteres o más.
SECURITY_ADMIN_PASSWORD=
# En producción, la dirección HTTPS exacta, sin barra al final.
# Para npm run dev dejar vacío (se valida el origen contra el host).
PUBLIC_ORIGIN=
# Carpeta privada persistente FUERA de dist/public.
SECURITY_DATA_DIR=private
PORT=3000
# Opcional: configurar claves por entorno en lugar del panel.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_HOSTNAMES=localhost,tudominio.com,www.tudominio.com
# RECAPTCHA_ENABLED=true
